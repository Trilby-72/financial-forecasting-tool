# --- Azure AD App Registration (client credentials flow) ---
# From Entra ID > App registrations > (your app) > Overview
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000

# From Entra ID > App registrations > (your app) > Certificates & secrets
# Do NOT commit the real value. In production, pull this from Azure Key Vault
# instead of a .env file.
AZURE_CLIENT_SECRET=changeme

# --- Staff source: choose ONE of the two options below ---

# Option A: a static list of staff UPNs/emails, defined in config/staff.json
STAFF_SOURCE=static

# Option B: pull membership dynamically from an Entra ID security group each
# time the cache refreshes. Requires GroupMember.Read.All (application) in
# addition to Calendars.Read. To use this, set STAFF_SOURCE=group and fill in:
STAFF_GROUP_ID=

# --- Server config ---
PORT=4000

# How long fetched calendar data is cached before Graph is queried again, in
# seconds. Keep this reasonably high (e.g. 300 = 5 min) — Graph will throttle
# an app that polls calendars for many users too frequently.
CACHE_TTL_SECONDS=300

# How many days ahead (from "now") to pull meetings for.
LOOKAHEAD_DAYS=7
